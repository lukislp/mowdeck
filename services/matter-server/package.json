{
  "name": "matter-server",
  "version": "0.1.0",
  "private": true,
  "description": "MowDeck Matter server: every mower as its own Matter node (Apple Home, Google Home, Home Assistant) with start, pause, dock, state and battery (ADR 0063).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-force-exit --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@matter/main": "0.18.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
