# Settings of the load test stack (tests/load/load.mjs), read after infra/compose/.env.example.
# Test values only, for a throwaway stack bound to 127.0.0.1; never use them for a real demo
# (infra/compose/demo/demo.env.example is the template of that).
#
# Everything a visitor meets is the public demo's default (docker-compose.demo.yml and
# demo.env.example): the rate limits, the socket limits, the history and the simulation speed.
DEMO_SEED_TOKEN=load-test-demo-seed-token
DEMO_RESET_HOURS=6
DEMO_HISTORY_DAYS=7
DEMO_SIM_TIME_SCALE=3
DEMO_RATE_PER_MINUTE=1200
DEMO_RATE_BURST=600
MOWDECK_ENVIRONMENT=prod
NOTIFICATIONS_DEFAULT_LANGUAGE=en
NOTIFICATIONS_MOWING_MIN_SECONDS=30
# The demo host's proxy setup (docs/ops/demo.md, "Client addresses behind a proxy"): k6 is the
# trusted proxy on the stack's own subnet (docker-compose.load.yml) and names every virtual
# visitor in X-Forwarded-For, so every per-address limit counts visitors, not the load generator.
GATEWAY_TRUSTED_PROXIES=10.251.77.0/24
GATEWAY_CLIENT_IP_DEPTH=1
# Plain HTTP inside the test network.
IDENTITY_REFRESH_COOKIE_SECURE=false
# Kept off as in a demo.
WEB_MAP_TILES=
AERIAL_WMS_URL=
AERIAL_XYZ_URL=
BASEMAP_URL=
WEB_CAMERA_ENABLED=false
WEB_AGORA_SDK=exclude
WEB_LEGAL_ENABLED=false
ENTITLEMENTS_BILLING_ENABLED=false
COMPOSE_PROFILES=
