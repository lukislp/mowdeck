# Overrides of infra/compose/.env.example for the Playwright suite (merged into the stack's
# .env by CI and by the local run, see tests/e2e-web and docs/dev/web-app.md#testing).
# schedules.spec.ts needs the static weather provider, switched at runtime through the
# development endpoint, and a short ticker so a schedule fires within seconds of its time.
SCHEDULER_WEATHER_PROVIDER=static
SCHEDULER_STATIC_WEATHER=dry
SCHEDULER_DEV_ENDPOINTS=true
SCHEDULER_TICK_SECONDS=5
# vision.spec.ts sets up the rule based fake vision provider (fake/recover) as the user's model.
VISION_ALLOW_FAKE_PROVIDER=true
# connection.spec.ts links a fake account (*@fake.mowdeck.test) and adds its mowers, and
# linked-providers-desktop.spec.ts links one in Settings: the Device-Gateway answers logins and
# connects cloud mowers through the fake clouds of the enabled providers (ADR 0066).
GATEWAY_FAKE_CLOUDS=true
# vision.spec.ts: a simulated mower without own photos (`photos: false`) gets its AI assist photo
# from the camera relay's frame tap (ADR 0045); the relay runs in every test stack.
GATEWAY_RELAY_URL=http://camera-relay:8000
RELAY_FRAMES_TOKEN=e2e-relay-frames-token
# passkeys-desktop.spec.ts: passkeys are bound to the address the browser opens (ADR 0050). CI
# opens http://localhost; the local run exports http://localhost:<port> (scripts/stack.mjs),
# which wins over this file. Production default: empty, passkeys off (infra/compose/.env.example).
IDENTITY_PUBLIC_URL=http://localhost
