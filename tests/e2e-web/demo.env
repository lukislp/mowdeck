# The public demo (ADR 0068) on top of the test stack: test values only, read after stack.env
# (`MOWDECK_E2E_DEMO=1 pnpm e2e:stack up`, and the CI job e2e-demo). Never use them for a real demo:
# infra/compose/demo/demo.env.example is the template of that.
DEMO_SEED_TOKEN=e2e-demo-seed-token
DEMO_RESET_HOURS=6
DEMO_HISTORY_DAYS=2
DEMO_SIM_TIME_SCALE=3
# Every spec starts with an empty browser cache and the whole suite runs from one address.
DEMO_RATE_PER_MINUTE=100000
DEMO_RATE_BURST=50000
# Demo sandboxes (ADR 0076): every spec starts new sandboxes (often two per test), all from the one
# address of the runner. The real caps (sandboxes in use, sandboxes per address and hour) are
# covered by Identity's tests; here they must never be the reason a spec fails.
DEMO_SANDBOX_MAX=500
DEMO_SANDBOX_PER_ADDRESS_PER_HOUR=100000
