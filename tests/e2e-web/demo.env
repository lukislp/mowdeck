# The public demo (ADR 0065) on top of the test stack: test values only, read after stack.env
# (`MOWDECK_E2E_DEMO=1 pnpm e2e:stack up`, and the CI job e2e-demo). Never use them for a real demo:
# infra/compose/demo/demo.env.example is the template of that.
DEMO_SEED_TOKEN=e2e-demo-seed-token
DEMO_RESET_HOURS=6
DEMO_HISTORY_DAYS=2
DEMO_SIM_TIME_SCALE=3
# The suite signs in many times from one address.
DEMO_RATE_PER_MINUTE=3000
DEMO_RATE_BURST=1000
