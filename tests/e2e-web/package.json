{
  "name": "e2e-web",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 2 gate: Playwright suite against a throwaway Compose stack (web app at /).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=phone --project=desktop --project=webkit --project=firefox",
    "screens": "playwright test --project=screens",
    "stack": "node scripts/stack.mjs",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
