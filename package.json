{
  "name": "mowdeck-frontend",
  "private": true,
  "description": "MowDeck web frontend workspace (root scripts only).",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "lint": "pnpm -r lint",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "build": "pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "format": "prettier --write . && eslint --fix .",
    "codegen": "pnpm --filter ts-codegen gen",
    "e2e:stack": "node tests/e2e-web/scripts/stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "postcss": "8.5.30",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "pnpm": {
    "overrides": {
      "xcode>uuid": "^11.1.1",
      "@sveltejs/kit>cookie": "^0.7.0"
    }
  }
}
