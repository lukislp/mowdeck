{
  "name": "@mowdeck/ui",
  "version": "0.1.0",
  "private": true,
  "description": "MowDeck design system: tokens and Svelte 5 components of the instrument panel.",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./styles/tokens.css": "./src/lib/styles/tokens.css",
    "./styles/base.css": "./src/lib/styles/base.css",
    "./styles/fonts.css": "./src/lib/styles/fonts.css",
    "./tokens": "./src/lib/styles/tokens.ts"
  },
  "files": [
    "src/lib"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore && stylelint \"src/**/*.{css,svelte}\"",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --coverage && node lint/contrast-check.js",
    "tokens:check": "node lint/contrast-check.js"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
