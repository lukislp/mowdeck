{
  "$defs": {
    "SpotCircle": {
      "description": "A round spot: ``radius_m`` around ``center_wgs84`` (``[lat, lon]``).",
      "properties": {
        "center_wgs84": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center Wgs84",
          "type": "array"
        },
        "radius_m": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Radius M",
          "type": "number"
        }
      },
      "required": [
        "center_wgs84",
        "radius_m"
      ],
      "title": "SpotCircle",
      "type": "object"
    },
    "SpotMowPlan": {
      "description": "A computed mowing route for ``StartMow.spot_plan``.",
      "properties": {
        "covered_area_m2": {
          "default": 0.0,
          "minimum": 0,
          "title": "Covered Area M2",
          "type": "number"
        },
        "estimated_duration_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Estimated Duration S",
          "type": "number"
        },
        "native": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpotNativeJob"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pattern_chain": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Pattern Chain",
          "type": "array"
        },
        "plan_hash": {
          "description": "SHA-256 of the chain and the segments (`spot_plan_hash`); must match.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/SpotSegment"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "plan_hash",
        "pattern_chain",
        "segments"
      ],
      "title": "SpotMowPlan",
      "type": "object"
    },
    "SpotNativeJob": {
      "description": "The plan expressed as a native job of the mower: whole map areas and one pattern.\n\nPresent only when the chain is exactly one pattern the mower may run by itself (``stripes``,\n``diagonal``, ``checkerboard``, ``edge_only``, or ``border_fill`` with one of them) on map\nareas, so a mower without ``custom_paths`` can still execute it as an ordinary\n``StartMow(area_ids, pattern)``.",
      "properties": {
        "area_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Area Ids",
          "type": "array"
        },
        "pattern": {
          "additionalProperties": true,
          "description": "Settings in the form of `StartMow.pattern` (`name`, `angle_deg`, `spacing_m`, `border_laps`, `order`).",
          "title": "Pattern",
          "type": "object"
        }
      },
      "required": [
        "area_ids",
        "pattern"
      ],
      "title": "SpotNativeJob",
      "type": "object"
    },
    "SpotPolygon": {
      "description": "A drawn spot: a closed ring of WGS84 ``[lat, lon]`` corners (first point not repeated).",
      "properties": {
        "polygon_wgs84": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 64,
          "minItems": 3,
          "title": "Polygon Wgs84",
          "type": "array"
        }
      },
      "required": [
        "polygon_wgs84"
      ],
      "title": "SpotPolygon",
      "type": "object"
    },
    "SpotSegment": {
      "description": "One part of a spot plan: drive along ``path`` with the blades on or off.",
      "properties": {
        "blades_on": {
          "title": "Blades On",
          "type": "boolean"
        },
        "kind": {
          "default": "mow",
          "enum": [
            "mow",
            "turn",
            "transfer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "description": "Encoded polyline of local metres (x, y), centimetre precision (`encode_polyline`), at least two points.",
          "maxLength": 200000,
          "minLength": 4,
          "title": "Path",
          "type": "string"
        },
        "speed_mps": {
          "exclusiveMinimum": 0,
          "maximum": 2.0,
          "title": "Speed Mps",
          "type": "number"
        }
      },
      "required": [
        "blades_on",
        "speed_mps",
        "path"
      ],
      "title": "SpotSegment",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Mow a small spot by driving the mower along ``plan`` with joystick frames (ADR 0039).\n\nUnlike ``StartMow.spot_plan`` the mower runs no job of its own: MowDeck's gateway steers it\nover the drive link (needs ``MowerCapabilities.manual_drive``, a fixed RTK position and an\nidle mower). The blades stay off (a dry run) unless ``blades`` and ``confirm_blades`` are\nboth true and the mower allows blades while driving (``manual_drive_blades``). ``spot``\nrecords what the user chose; the route is ``plan``. Progress arrives in\n``MowerState.spot_run``; ``SpotStop`` ends the run.",
  "properties": {
    "blades": {
      "default": false,
      "description": "Cut while driving (else a dry run).",
      "title": "Blades",
      "type": "boolean"
    },
    "confirm_blades": {
      "default": false,
      "description": "The user confirmed the blades separately; required with `blades`.",
      "title": "Confirm Blades",
      "type": "boolean"
    },
    "kind": {
      "const": "spot_mow",
      "default": "spot_mow",
      "title": "Kind",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/SpotMowPlan"
    },
    "speed_mps": {
      "default": 0.2,
      "description": "Driving speed of the run in metres per second (at most 0.3).",
      "exclusiveMinimum": 0,
      "maximum": 0.3,
      "title": "Speed Mps",
      "type": "number"
    },
    "spot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpotCircle"
        },
        {
          "$ref": "#/$defs/SpotPolygon"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The spot as the user chose it (audit only).",
      "title": "Spot"
    }
  },
  "required": [
    "plan"
  ],
  "title": "SpotMow",
  "type": "object"
}
