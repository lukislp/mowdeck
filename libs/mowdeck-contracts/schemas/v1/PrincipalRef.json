{
  "$defs": {
    "PrincipalKind": {
      "description": "What kind of subject a principal is.",
      "enum": [
        "user",
        "subuser",
        "api_token",
        "service"
      ],
      "title": "PrincipalKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A compact reference to a principal, embedded in commands and audit records.",
  "properties": {
    "display_name": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "kind": {
      "$ref": "#/$defs/PrincipalKind",
      "description": "Kind of subject."
    },
    "subject": {
      "description": "Stable subject id (JWT `sub`).",
      "format": "uuid",
      "title": "Subject",
      "type": "string"
    },
    "token_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Token id (JWT `jti`), if known.",
      "title": "Token Id"
    }
  },
  "required": [
    "subject",
    "kind"
  ],
  "title": "PrincipalRef",
  "type": "object"
}
