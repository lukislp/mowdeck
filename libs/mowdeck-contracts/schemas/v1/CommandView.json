{
  "$defs": {
    "CommandPriority": {
      "description": "Delivery priority of a command. Only :class:`EmergencyStop` uses ``emergency``.",
      "enum": [
        "normal",
        "emergency"
      ],
      "title": "CommandPriority",
      "type": "string"
    },
    "CommandState": {
      "description": "Status of a command record in Fleet.",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "executed",
        "expired",
        "failed"
      ],
      "title": "CommandState",
      "type": "string"
    },
    "PrincipalKind": {
      "description": "What kind of subject a principal is.",
      "enum": [
        "user",
        "subuser",
        "api_token",
        "service"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "PrincipalRef": {
      "description": "A compact reference to a principal, embedded in commands and audit records.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind",
          "description": "Kind of subject."
        },
        "subject": {
          "description": "Stable subject id (JWT `sub`).",
          "format": "uuid",
          "title": "Subject",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token id (JWT `jti`), if known.",
          "title": "Token Id"
        }
      },
      "required": [
        "subject",
        "kind"
      ],
      "title": "PrincipalRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A command record as clients read it (``GET /commands/{id}``).",
  "properties": {
    "bulk_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bulk Id"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "correlation_id": {
      "pattern": "^[A-Za-z0-9._:\\-]{1,128}$",
      "title": "Correlation Id",
      "type": "string"
    },
    "end_job": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For a `return_to_dock`: whether it also ended the job; None for other kinds.",
      "title": "End Job"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "issued_by": {
      "$ref": "#/$defs/PrincipalRef"
    },
    "kind": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Service that issued the command on behalf of `issued_by` (e.g. `scheduler`); None for commands sent through the API.",
      "title": "Origin"
    },
    "pattern": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For a `start_mow` on map areas: the pattern settings it was sent with (`StartMow.pattern`, mostly `MowPattern` keys); None otherwise or when it had none.",
      "title": "Pattern"
    },
    "plan_hash": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hash of the spot plan of a `start_mow` with `spot_plan`, if any.",
      "title": "Plan Hash"
    },
    "priority": {
      "$ref": "#/$defs/CommandPriority"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "result_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Time of the latest result applied to the record.",
      "title": "Result At"
    },
    "schedule_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The schedule that issued the command, if any.",
      "title": "Schedule Id"
    },
    "status": {
      "$ref": "#/$defs/CommandState"
    }
  },
  "required": [
    "command_id",
    "mower_id",
    "kind",
    "priority",
    "status",
    "issued_by",
    "issued_at",
    "expires_at",
    "correlation_id"
  ],
  "title": "CommandView",
  "type": "object"
}
