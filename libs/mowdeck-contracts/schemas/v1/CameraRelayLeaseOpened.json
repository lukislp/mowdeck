{
  "$defs": {
    "PrincipalKind": {
      "description": "What kind of subject a principal is.",
      "enum": [
        "user",
        "subuser",
        "api_token",
        "service"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "PrincipalRef": {
      "description": "A compact reference to a principal, embedded in commands and audit records.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind",
          "description": "Kind of subject."
        },
        "subject": {
          "description": "Stable subject id (JWT `sub`).",
          "format": "uuid",
          "title": "Subject",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token id (JWT `jti`), if known.",
          "title": "Token Id"
        }
      },
      "required": [
        "subject",
        "kind"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "RelayPurpose": {
      "description": "Why a lease holds the session.",
      "enum": [
        "viewer",
        "vision"
      ],
      "title": "RelayPurpose",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payload of ``camera.relay.lease_opened`` on ``camera.mower.<id>.relay.lease_opened``.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "camera_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Camera Ids",
      "type": "array"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "purpose": {
      "$ref": "#/$defs/RelayPurpose"
    },
    "relay_session_id": {
      "format": "uuid",
      "title": "Relay Session Id",
      "type": "string"
    },
    "requested_by": {
      "$ref": "#/$defs/PrincipalRef"
    }
  },
  "required": [
    "lease_id",
    "relay_session_id",
    "account_id",
    "mower_id",
    "purpose",
    "requested_by",
    "camera_ids",
    "opened_at"
  ],
  "title": "CameraRelayLeaseOpened",
  "type": "object"
}
