{
  "$defs": {
    "PrincipalKind": {
      "description": "What kind of subject a principal is.",
      "enum": [
        "user",
        "subuser",
        "api_token",
        "service"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "PrincipalRef": {
      "description": "A compact reference to a principal, embedded in commands and audit records.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind",
          "description": "Kind of subject."
        },
        "subject": {
          "description": "Stable subject id (JWT `sub`).",
          "format": "uuid",
          "title": "Subject",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token id (JWT `jti`), if known.",
          "title": "Token Id"
        }
      },
      "required": [
        "subject",
        "kind"
      ],
      "title": "PrincipalRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request on ``gateway.mower.<id>.path.preview`` (internal, Fleet to Device-Gateway).",
  "properties": {
    "account_id": {
      "description": "The mower's account as Fleet knows it.",
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "area_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Area Ids",
      "type": "array"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    },
    "pattern": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pattern"
    },
    "requested_by": {
      "$ref": "#/$defs/PrincipalRef"
    }
  },
  "required": [
    "mower_id",
    "account_id",
    "area_ids",
    "requested_by"
  ],
  "title": "PathPreviewGatewayRequest",
  "type": "object"
}
