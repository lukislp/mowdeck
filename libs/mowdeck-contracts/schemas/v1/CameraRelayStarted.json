{
  "$defs": {
    "CameraProvider": {
      "description": "Who delivers the video.",
      "enum": [
        "agora",
        "fake",
        "relay"
      ],
      "title": "CameraProvider",
      "type": "string"
    },
    "PrincipalKind": {
      "description": "What kind of subject a principal is.",
      "enum": [
        "user",
        "subuser",
        "api_token",
        "service"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "PrincipalRef": {
      "description": "A compact reference to a principal, embedded in commands and audit records.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind",
          "description": "Kind of subject."
        },
        "subject": {
          "description": "Stable subject id (JWT `sub`).",
          "format": "uuid",
          "title": "Subject",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token id (JWT `jti`), if known.",
          "title": "Token Id"
        }
      },
      "required": [
        "subject",
        "kind"
      ],
      "title": "PrincipalRef",
      "type": "object"
    },
    "RelayPurpose": {
      "description": "Why a lease holds the session.",
      "enum": [
        "viewer",
        "vision"
      ],
      "title": "RelayPurpose",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payload of ``camera.relay.started`` on ``camera.mower.<id>.relay.started``: the relay\njoined the source and has media.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "camera_ids": {
      "description": "The cameras that publish.",
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Camera Ids",
      "type": "array"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    },
    "relay_session_id": {
      "format": "uuid",
      "title": "Relay Session Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CameraProvider",
      "description": "The provider of the source (not `relay`)."
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "started_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrincipalRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Who opened the lease that started the session."
    },
    "trigger": {
      "anyOf": [
        {
          "$ref": "#/$defs/RelayPurpose"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Purpose of the lease that started the session."
    }
  },
  "required": [
    "relay_session_id",
    "account_id",
    "mower_id",
    "source",
    "camera_ids",
    "started_at"
  ],
  "title": "CameraRelayStarted",
  "type": "object"
}
