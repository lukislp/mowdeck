{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request on ``fleet.mowers.credentials`` (internal, Device-Gateway to Fleet).",
  "properties": {
    "account_id": {
      "description": "The mower's account as the gateway knows it.",
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    }
  },
  "required": [
    "mower_id",
    "account_id"
  ],
  "title": "MowerCredentialsRequest",
  "type": "object"
}
