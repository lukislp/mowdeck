{
  "$defs": {
    "NotificationKind": {
      "description": "What a notification is about.",
      "enum": [
        "mowing_finished",
        "mower_stuck",
        "battery_low",
        "mower_offline",
        "mower_online",
        "job_started",
        "mower_lifted",
        "mower_left_dock_unexpectedly",
        "geofence_exit",
        "blade_maintenance",
        "vision_proposal",
        "vision_auto_proposal",
        "firmware_update_available",
        "firmware_update_finished",
        "firmware_update_failed",
        "tracking_started",
        "tracking_moved",
        "tracking_stale",
        "tracking_ended",
        "test"
      ],
      "title": "NotificationKind",
      "type": "string"
    },
    "NotificationSeverity": {
      "description": "How urgent a notification is; channels map it to TTL, urgency or priority.",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "NotificationSeverity",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payload of ``notifications.sent``: one notification for one user, already rendered.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "body": {
      "maxLength": 1000,
      "title": "Body",
      "type": "string"
    },
    "channels": {
      "description": "Channels a delivery was queued for (may be empty).",
      "items": {
        "type": "string"
      },
      "title": "Channels",
      "type": "array"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the inbox item was stored; null in events from before the field.",
      "title": "Created At"
    },
    "kind": {
      "$ref": "#/$defs/NotificationKind"
    },
    "mower_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mower Id"
    },
    "notification_id": {
      "format": "uuid",
      "title": "Notification Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/NotificationSeverity"
    },
    "title": {
      "maxLength": 200,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "user_id": {
      "format": "uuid",
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "notification_id",
    "user_id",
    "account_id",
    "kind",
    "severity",
    "title",
    "body",
    "occurred_at"
  ],
  "title": "NotificationSent",
  "type": "object"
}
