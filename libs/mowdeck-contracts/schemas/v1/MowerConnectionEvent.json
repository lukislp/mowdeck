{
  "$defs": {
    "ConnectionKind": {
      "description": "How the Device-Gateway is connected to the mower.",
      "enum": [
        "ble_bridge",
        "wifi",
        "cloud",
        "simulated"
      ],
      "title": "ConnectionKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payload of ``mower.connected`` and ``mower.disconnected``.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "connection_kind": {
      "$ref": "#/$defs/ConnectionKind"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the link ended (disconnected only).",
      "title": "Reason"
    }
  },
  "required": [
    "mower_id",
    "account_id",
    "connection_kind"
  ],
  "title": "MowerConnectionEvent",
  "type": "object"
}
