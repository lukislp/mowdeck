{
  "$defs": {
    "ErrorExplanation": {
      "description": "A vendor code in plain words, in one locale.",
      "properties": {
        "category": {
          "$ref": "#/$defs/MowerErrorCategory"
        },
        "cause": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause"
        },
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "known": {
          "description": "The lexicon knows the code.",
          "title": "Known",
          "type": "boolean"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/ErrorLink"
          },
          "title": "Links",
          "type": "array"
        },
        "locale": {
          "description": "The locale of the texts (after fallback).",
          "pattern": "^[a-z]{2}$",
          "title": "Locale",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ErrorSeverity"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "user_action": {
          "title": "User Action",
          "type": "boolean"
        },
        "vendor": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The lexicon that explained the code; null when none applied.",
          "title": "Vendor"
        },
        "vendor_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor Name"
        },
        "verified": {
          "default": true,
          "description": "False for an entry whose meaning is not verified.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "known",
        "locale",
        "title",
        "severity",
        "category",
        "user_action"
      ],
      "title": "ErrorExplanation",
      "type": "object"
    },
    "ErrorLink": {
      "description": "Further reading for an entry (the vendor's help page, a manual chapter).",
      "properties": {
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "ErrorLink",
      "type": "object"
    },
    "ErrorSeverity": {
      "description": "How bad an error is for the user, manufacturer neutral.",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "ErrorSeverity",
      "type": "string"
    },
    "MowerErrorCategory": {
      "description": "What kind of fault ``MowerState.error_code`` names, manufacturer neutral.\n\nThe same words classify the entries of an error lexicon (ADR 0065), so rules such as the\ntheft alarm can match a category instead of vendor codes.",
      "enum": [
        "trapped",
        "obstacle",
        "outside",
        "wheel_slip",
        "lift_tilt",
        "collision",
        "battery",
        "blade_motor",
        "rain",
        "positioning",
        "communication",
        "docking",
        "firmware",
        "other"
      ],
      "title": "MowerErrorCategory",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One explanation per requested code, in request order.",
  "properties": {
    "explanations": {
      "items": {
        "$ref": "#/$defs/ErrorExplanation"
      },
      "title": "Explanations",
      "type": "array"
    }
  },
  "title": "ErrorExplainReply",
  "type": "object"
}
