{
  "$defs": {
    "PrincipalKind": {
      "description": "What kind of subject a principal is.",
      "enum": [
        "user",
        "subuser",
        "api_token",
        "service"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "PrincipalRef": {
      "description": "A compact reference to a principal, embedded in commands and audit records.",
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKind",
          "description": "Kind of subject."
        },
        "subject": {
          "description": "Stable subject id (JWT `sub`).",
          "format": "uuid",
          "title": "Subject",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token id (JWT `jti`), if known.",
          "title": "Token Id"
        }
      },
      "required": [
        "subject",
        "kind"
      ],
      "title": "PrincipalRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request on ``relay.camera.renew``: the heartbeat of one lease.\n\nIt extends the lease by :data:`RELAY_LEASE_TTL_SECONDS` and issues a fresh ticket for\nreconnects. A lease of another account is ``forbidden``, an unknown one ``not_found``.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "mower_id": {
      "format": "uuid",
      "title": "Mower Id",
      "type": "string"
    },
    "requested_by": {
      "$ref": "#/$defs/PrincipalRef"
    }
  },
  "required": [
    "account_id",
    "mower_id",
    "lease_id",
    "requested_by"
  ],
  "title": "RelayRenewRequest",
  "type": "object"
}
