{
  "$defs": {
    "MowPath": {
      "description": "The route a mower planned, in the local metres of its map.",
      "properties": {
        "area_ids": {
          "description": "The map areas the route covers, in order.",
          "items": {
            "type": "string"
          },
          "title": "Area Ids",
          "type": "array"
        },
        "kinds": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "mow",
                  "edge",
                  "transfer",
                  "other"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The kind of every polyline (same length), when known.",
          "title": "Kinds"
        },
        "path_hash": {
          "description": "The vendor's id of the planned route.",
          "maxLength": 32,
          "minLength": 1,
          "title": "Path Hash",
          "type": "string"
        },
        "planned_at": {
          "description": "When MowDeck received the route (UTC).",
          "format": "date-time",
          "title": "Planned At",
          "type": "string"
        },
        "points_total": {
          "description": "Number of points over all polylines.",
          "minimum": 0,
          "title": "Points Total",
          "type": "integer"
        },
        "polylines": {
          "description": "The route as polylines in driving order.",
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": "Polylines",
          "type": "array"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/MowPathProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Progress of the running job; None for a preview."
        }
      },
      "required": [
        "path_hash",
        "points_total",
        "planned_at"
      ],
      "title": "MowPath",
      "type": "object"
    },
    "MowPathProgress": {
      "description": "Where the mower is along its path.",
      "properties": {
        "direction": {
          "default": 0,
          "description": "The vendor's traversal direction flag (0 or 1).",
          "maximum": 255,
          "minimum": 0,
          "title": "Direction",
          "type": "integer"
        },
        "index": {
          "description": "Points done so far, counted over all polylines in order: the points with a flat index below this value are mowed.",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "index"
      ],
      "title": "MowPathProgress",
      "type": "object"
    },
    "PathPreviewError": {
      "description": "The error of a :class:`PathPreviewReply`.",
      "properties": {
        "code": {
          "$ref": "#/$defs/PathPreviewErrorCode"
        },
        "detail": {
          "maxLength": 500,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "PathPreviewError",
      "type": "object"
    },
    "PathPreviewErrorCode": {
      "description": "Why no preview was given.",
      "enum": [
        "not_found",
        "forbidden",
        "unsupported",
        "rejected",
        "unavailable",
        "timeout",
        "failed"
      ],
      "title": "PathPreviewErrorCode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Reply to :class:`PathPreviewGatewayRequest`: exactly one of ``path`` or ``error``.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathPreviewError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "path": {
      "anyOf": [
        {
          "$ref": "#/$defs/MowPath"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "PathPreviewReply",
  "type": "object"
}
