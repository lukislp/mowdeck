{
  "$defs": {
    "ConnectionKind": {
      "description": "How the Device-Gateway is connected to the mower.",
      "enum": [
        "ble_bridge",
        "wifi",
        "cloud",
        "simulated"
      ],
      "title": "ConnectionKind",
      "type": "string"
    },
    "ErrorExplanation": {
      "description": "A vendor code in plain words, in one locale.",
      "properties": {
        "category": {
          "$ref": "#/$defs/MowerErrorCategory"
        },
        "cause": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause"
        },
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "known": {
          "description": "The lexicon knows the code.",
          "title": "Known",
          "type": "boolean"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/ErrorLink"
          },
          "title": "Links",
          "type": "array"
        },
        "locale": {
          "description": "The locale of the texts (after fallback).",
          "pattern": "^[a-z]{2}$",
          "title": "Locale",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ErrorSeverity"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        },
        "user_action": {
          "title": "User Action",
          "type": "boolean"
        },
        "vendor": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The lexicon that explained the code; null when none applied.",
          "title": "Vendor"
        },
        "vendor_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vendor Name"
        },
        "verified": {
          "default": true,
          "description": "False for an entry whose meaning is not verified.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "known",
        "locale",
        "title",
        "severity",
        "category",
        "user_action"
      ],
      "title": "ErrorExplanation",
      "type": "object"
    },
    "ErrorLexiconInfo": {
      "description": "Summary of an installed lexicon (no entries).",
      "properties": {
        "connection_kinds": {
          "items": {
            "$ref": "#/$defs/ConnectionKind"
          },
          "title": "Connection Kinds",
          "type": "array"
        },
        "entries": {
          "description": "Number of codes.",
          "minimum": 0,
          "title": "Entries",
          "type": "integer"
        },
        "locales": {
          "items": {
            "pattern": "^[a-z]{2}$",
            "type": "string"
          },
          "title": "Locales",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unverified": {
          "description": "Codes whose meaning could not be verified.",
          "minimum": 0,
          "title": "Unverified",
          "type": "integer"
        },
        "vendor": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Vendor",
          "type": "string"
        },
        "vendor_name": {
          "title": "Vendor Name",
          "type": "string"
        }
      },
      "required": [
        "vendor",
        "vendor_name",
        "entries",
        "unverified"
      ],
      "title": "ErrorLexiconInfo",
      "type": "object"
    },
    "ErrorLink": {
      "description": "Further reading for an entry (the vendor's help page, a manual chapter).",
      "properties": {
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "url": {
          "maxLength": 500,
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "ErrorLink",
      "type": "object"
    },
    "ErrorSeverity": {
      "description": "How bad an error is for the user, manufacturer neutral.",
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "ErrorSeverity",
      "type": "string"
    },
    "MowerErrorCategory": {
      "description": "What kind of fault ``MowerState.error_code`` names, manufacturer neutral.\n\nThe same words classify the entries of an error lexicon (ADR 0067), so rules such as the\ntheft alarm can match a category instead of vendor codes.",
      "enum": [
        "trapped",
        "obstacle",
        "outside",
        "wheel_slip",
        "lift_tilt",
        "collision",
        "battery",
        "blade_motor",
        "rain",
        "positioning",
        "communication",
        "docking",
        "firmware",
        "other"
      ],
      "title": "MowerErrorCategory",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A page of a lexicon's entries, ordered by code (numbers numerically).",
  "properties": {
    "categories": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Entries per category in the whole lexicon (for filter chips).",
      "propertyNames": {
        "$ref": "#/$defs/MowerErrorCategory"
      },
      "title": "Categories",
      "type": "object"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ErrorExplanation"
      },
      "title": "Entries",
      "type": "array"
    },
    "lexicon": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorLexiconInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The lexicon searched; null when none applies (or none answered)."
    },
    "offset": {
      "default": 0,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "severities": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Entries per severity in the whole lexicon.",
      "propertyNames": {
        "$ref": "#/$defs/ErrorSeverity"
      },
      "title": "Severities",
      "type": "object"
    },
    "total": {
      "default": 0,
      "description": "Entries matching the filters.",
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "title": "ErrorLexiconSearchReply",
  "type": "object"
}
