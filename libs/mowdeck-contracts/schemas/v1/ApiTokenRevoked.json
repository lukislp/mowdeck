{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Payload of ``identity.api_token.revoked``.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "token_id": {
      "format": "uuid",
      "title": "Token Id",
      "type": "string"
    }
  },
  "required": [
    "token_id",
    "account_id",
    "reason"
  ],
  "title": "ApiTokenRevoked",
  "type": "object"
}
