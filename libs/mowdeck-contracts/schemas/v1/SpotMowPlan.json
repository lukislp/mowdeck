{
  "$defs": {
    "SpotNativeJob": {
      "description": "The plan expressed as a native job of the mower: whole map areas and one pattern.\n\nPresent only when the chain is exactly one pattern the mower may run by itself (``stripes``,\n``diagonal``, ``checkerboard``, ``edge_only``, or ``border_fill`` with one of them) on map\nareas, so a mower without ``custom_paths`` can still execute it as an ordinary\n``StartMow(area_ids, pattern)``.",
      "properties": {
        "area_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Area Ids",
          "type": "array"
        },
        "pattern": {
          "additionalProperties": true,
          "description": "Settings in the form of `StartMow.pattern` (`name`, `angle_deg`, `spacing_m`, `border_laps`, `order`).",
          "title": "Pattern",
          "type": "object"
        }
      },
      "required": [
        "area_ids",
        "pattern"
      ],
      "title": "SpotNativeJob",
      "type": "object"
    },
    "SpotSegment": {
      "description": "One part of a spot plan: drive along ``path`` with the blades on or off (backwards with\n``reverse``: the mower faces against the direction of travel, part of a three-point\nturn).",
      "properties": {
        "blades_on": {
          "title": "Blades On",
          "type": "boolean"
        },
        "kind": {
          "default": "mow",
          "enum": [
            "mow",
            "turn",
            "transfer"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "description": "Encoded polyline of local metres (x, y), centimetre precision (`encode_polyline`), at least two points.",
          "maxLength": 200000,
          "minLength": 4,
          "title": "Path",
          "type": "string"
        },
        "reverse": {
          "default": false,
          "description": "Drive the polyline backwards (negative linear speed, the mower faces against the direction of travel); always with the blades off (ADR 0043).",
          "title": "Reverse",
          "type": "boolean"
        },
        "speed_mps": {
          "exclusiveMinimum": 0,
          "maximum": 2.0,
          "title": "Speed Mps",
          "type": "number"
        }
      },
      "required": [
        "blades_on",
        "speed_mps",
        "path"
      ],
      "title": "SpotSegment",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A computed mowing route for ``StartMow.spot_plan``.",
  "properties": {
    "covered_area_m2": {
      "default": 0.0,
      "minimum": 0,
      "title": "Covered Area M2",
      "type": "number"
    },
    "estimated_duration_s": {
      "default": 0.0,
      "minimum": 0,
      "title": "Estimated Duration S",
      "type": "number"
    },
    "native": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpotNativeJob"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pattern_chain": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Pattern Chain",
      "type": "array"
    },
    "plan_hash": {
      "description": "SHA-256 of the chain and the segments (`spot_plan_hash`); must match.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/SpotSegment"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "plan_hash",
    "pattern_chain",
    "segments"
  ],
  "title": "SpotMowPlan",
  "type": "object"
}
