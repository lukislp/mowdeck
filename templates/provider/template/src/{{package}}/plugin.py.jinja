"""The entry point object of the {{ vendor_name }} provider (``mowdeck.cloud_providers``:
``{{ vendor }}``).

Importable without {{ sdk_module }}: the gateway loads every installed spec, also of disabled
providers, so the vendor SDK is imported only in :func:`create`, when the provider is enabled.
Off by default (``enabled_by_default=False``) until it was tested on a real mower; operators
enable it with ``MOWDECK_CLOUD_PROVIDERS_ENABLE={{ vendor }}``.
"""

from typing import Final

from mowdeck_control import CloudProviderPlugin, ProviderContext, ProviderSpec

from {{ package }}.descriptor import PROVIDER


def create(context: ProviderContext) -> CloudProviderPlugin:
    """The plugin for ``context`` (the real cloud, or the fake one)."""
    from {{ package }}.provider import create_provider

    return create_provider(context)


SPEC: Final = ProviderSpec(provider=PROVIDER, create=create, enabled_by_default=False)
"""The entry point object (``mowdeck.cloud_providers``: ``{{ vendor }}``)."""
