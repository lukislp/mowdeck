# Compose block for {{ service_name }}: paste the entries below "services:" into
# infra/compose/docker-compose.yml. Build context is the repository root.
services:
{%- if needs_db %}
  {{ service_name }}-migrate:
    image: mowdeck/{{ service_name }}:${MOWDECK_VERSION:-dev}
    build:
      context: ../..
      dockerfile: services/{{ service_name }}/Dockerfile
      args:
        PYTHON_IMAGE: ${PYTHON_IMAGE:-public.ecr.aws/docker/library/python:3.13-slim}
        UV_IMAGE: ${UV_IMAGE:-ghcr.io/astral-sh/uv:0.12.24}
    command: ["python", "-m", "{{ package_name }}.adapters.db.migrate"]
    read_only: true
    tmpfs: [/tmp]
    environment:
      MOWDECK_DATABASE_URL: postgresql://{{ package_name }}:${SERVICE_DB_PASSWORD:?set SERVICE_DB_PASSWORD}@postgres:5432/{{ package_name }}
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"
    networks: [mowdeck]
{%- endif %}

  {{ service_name }}:
    image: mowdeck/{{ service_name }}:${MOWDECK_VERSION:-dev}
    build:
      context: ../..
      dockerfile: services/{{ service_name }}/Dockerfile
      args:
        PYTHON_IMAGE: ${PYTHON_IMAGE:-public.ecr.aws/docker/library/python:3.13-slim}
        UV_IMAGE: ${UV_IMAGE:-ghcr.io/astral-sh/uv:0.12.24}
    restart: unless-stopped
    read_only: true
    tmpfs: [/tmp]
    environment:
      MOWDECK_ENVIRONMENT: ${MOWDECK_ENVIRONMENT:-dev}
      MOWDECK_LOG_LEVEL: ${MOWDECK_LOG_LEVEL:-INFO}
      MOWDECK_NATS_URL: nats://nats:4222
{%- if needs_db %}
      MOWDECK_DATABASE_URL: postgresql://{{ package_name }}:${SERVICE_DB_PASSWORD:?set SERVICE_DB_PASSWORD}@postgres:5432/{{ package_name }}
{%- endif %}
    labels:
      - traefik.enable=true
      - traefik.http.routers.{{ service_name }}.rule=PathPrefix(`/api/v1/{{ service_name }}`)
      - traefik.http.routers.{{ service_name }}.entrypoints=web
      - traefik.http.services.{{ service_name }}.loadbalancer.server.port={{ http_port }}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ http_port }}/readyz', timeout=2)"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 5s
    depends_on:
      nats:
        condition: service_healthy
{%- if needs_db %}
      {{ service_name }}-migrate:
        condition: service_completed_successfully
{%- endif %}
    networks: [mowdeck]
