# Compose block for {{ service_name }}: paste the entries below "services:" into
# infra/compose/docker-compose.yml. Build context is the repository root.
# NATS (ADR 0073): add the user {{ service_name }} with the subjects it uses to USERS in
# tools/repo-checks/scripts/nats_auth.py, run `uv run poe nats-auth`, and add
# NATS_PASSWORD_{{ service_name | upper | replace('-', '_') }} to the nats service, .env.example,
# demo/demo.env.example and secrets of the Helm chart's values.yaml.
services:
{%- if needs_db %}
  {{ service_name }}-migrate:
    image: mowdeck/{{ service_name }}:${MOWDECK_VERSION:-dev}
    build:
      context: ../..
      dockerfile: services/{{ service_name }}/Dockerfile
      args:
        PYTHON_IMAGE: ${PYTHON_IMAGE:-public.ecr.aws/docker/library/python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f}
        UV_IMAGE: ${UV_IMAGE:-ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a}
    command: ["python", "-m", "{{ package_name }}.adapters.db.migrate"]
    read_only: true
    tmpfs: [/tmp]
    environment:
      MOWDECK_DATABASE_URL: postgresql://{{ package_name }}:${SERVICE_DB_PASSWORD:?set SERVICE_DB_PASSWORD}@postgres:5432/{{ package_name }}
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"
    networks: [mowdeck]
{%- endif %}

  {{ service_name }}:
    image: mowdeck/{{ service_name }}:${MOWDECK_VERSION:-dev}
    build:
      context: ../..
      dockerfile: services/{{ service_name }}/Dockerfile
      args:
        PYTHON_IMAGE: ${PYTHON_IMAGE:-public.ecr.aws/docker/library/python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f}
        UV_IMAGE: ${UV_IMAGE:-ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a}
    restart: unless-stopped
    read_only: true
    tmpfs: [/tmp]
    environment:
      MOWDECK_ENVIRONMENT: ${MOWDECK_ENVIRONMENT:-dev}
      MOWDECK_LOG_LEVEL: ${MOWDECK_LOG_LEVEL:-INFO}
      MOWDECK_NATS_URL: nats://nats:4222
      MOWDECK_NATS_USER: {{ service_name }}
      MOWDECK_NATS_PASSWORD: ${NATS_PASSWORD_{{ service_name | upper | replace('-', '_') }}:?set NATS_PASSWORD_{{ service_name | upper | replace('-', '_') }} in infra/compose/.env (./nats-passwords.sh .env, docs/ops/compose.md)}
{%- if needs_db %}
      MOWDECK_DATABASE_URL: postgresql://{{ package_name }}:${SERVICE_DB_PASSWORD:?set SERVICE_DB_PASSWORD}@postgres:5432/{{ package_name }}
{%- endif %}
    labels:
      - traefik.enable=true
      - traefik.http.routers.{{ service_name }}.rule=PathPrefix(`/api/v1/{{ service_name }}`)
      - traefik.http.routers.{{ service_name }}.entrypoints=web
      - traefik.http.services.{{ service_name }}.loadbalancer.server.port={{ http_port }}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ http_port }}/readyz', timeout=2)"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 5s
    depends_on:
      nats:
        condition: service_healthy
      nats-streams:
        condition: service_completed_successfully
{%- if needs_db %}
      {{ service_name }}-migrate:
        condition: service_completed_successfully
{%- endif %}
    networks: [mowdeck]
