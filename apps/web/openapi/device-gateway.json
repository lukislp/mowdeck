{
  "components": {
    "schemas": {
      "ConnectionKind": {
        "description": "How the Device-Gateway is connected to the mower.",
        "enum": [
          "ble_bridge",
          "wifi",
          "cloud",
          "simulated"
        ],
        "title": "ConnectionKind",
        "type": "string"
      },
      "ConnectionStatus": {
        "description": "Link state of one mower held by the gateway.",
        "enum": [
          "connecting",
          "connected",
          "reconnecting",
          "closed"
        ],
        "title": "ConnectionStatus",
        "type": "string"
      },
      "EventDef": {
        "description": "An event type a module publishes.",
        "properties": {
          "schema_ref": {
            "description": "Reference to the payload JSON Schema (URI or package path).",
            "minLength": 1,
            "title": "Schema Ref",
            "type": "string"
          },
          "type": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Type",
            "type": "string"
          },
          "version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "schema_ref"
        ],
        "title": "EventDef",
        "type": "object"
      },
      "FeatureDef": {
        "description": "A plan feature a module offers, e.g. ``reports``.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "FeatureDef",
        "type": "object"
      },
      "HeldMower": {
        "description": "A mower held by this Device-Gateway instance.",
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "activity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MowerActivity"
              },
              {
                "type": "null"
              }
            ]
          },
          "battery_percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery Percent"
          },
          "commands_in_flight": {
            "title": "Commands In Flight",
            "type": "integer"
          },
          "connected_since": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connected Since"
          },
          "connection_kind": {
            "$ref": "#/components/schemas/ConnectionKind"
          },
          "last_activity_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Activity At"
          },
          "mower_id": {
            "format": "uuid",
            "title": "Mower Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConnectionStatus"
          }
        },
        "required": [
          "mower_id",
          "account_id",
          "name",
          "connection_kind",
          "status",
          "connected_since",
          "last_activity_at",
          "activity",
          "battery_percent",
          "commands_in_flight"
        ],
        "title": "HeldMower",
        "type": "object"
      },
      "HeldMowers": {
        "description": "The mowers of this instance's shard.",
        "properties": {
          "mowers": {
            "items": {
              "$ref": "#/components/schemas/HeldMower"
            },
            "title": "Mowers",
            "type": "array"
          },
          "shard_count": {
            "title": "Shard Count",
            "type": "integer"
          },
          "shard_index": {
            "title": "Shard Index",
            "type": "integer"
          }
        },
        "required": [
          "shard_index",
          "shard_count",
          "mowers"
        ],
        "title": "HeldMowers",
        "type": "object"
      },
      "ModuleDescriptor": {
        "description": "Self-description of a service, served at ``/.well-known/mowdeck-module``.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventDef"
            },
            "title": "Events",
            "type": "array"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureDef"
            },
            "title": "Features",
            "type": "array"
          },
          "name": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9\\-]*$",
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/PermissionDef"
            },
            "title": "Permissions",
            "type": "array"
          },
          "ui_areas": {
            "items": {
              "$ref": "#/components/schemas/UiAreaDef"
            },
            "title": "Ui Areas",
            "type": "array"
          },
          "version": {
            "maxLength": 64,
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.\\-+]+)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModuleDescriptor",
        "type": "object"
      },
      "MowerActivity": {
        "description": "What the mower is doing right now.",
        "enum": [
          "idle",
          "mowing",
          "paused",
          "returning",
          "docked",
          "charging",
          "error",
          "offline",
          "updating",
          "unknown"
        ],
        "title": "MowerActivity",
        "type": "string"
      },
      "PermissionDef": {
        "description": "A permission a module defines, e.g. ``mower.control``.\n\nKeys that have a relation in the authorization model are checked per object in OpenFGA.\nOther keys are coarse, account-wide permissions carried in the access token (``perms``) and\nchecked with ``require_permission``. ``implied_by`` lets such a key follow an existing one:\nwhoever holds every listed key on the whole account also holds this key.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "implied_by": {
            "description": "Keys that imply this one when held on the whole account (e.g. `device_gateway.view` implied by `mower.view`).",
            "items": {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            "title": "Implied By",
            "type": "array"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "PermissionDef",
        "type": "object"
      },
      "UiAreaDef": {
        "description": "An area the module occupies in the web app shell.",
        "properties": {
          "labels": {
            "description": "Translated menu labels by language tag (e.g. `de`); `menu_label` is the English fallback.",
            "patternProperties": {
              "^[a-z]{2}(-[A-Z]{2})?$": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Labels",
            "type": "object"
          },
          "menu_label": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Menu Label",
            "type": "string"
          },
          "required_permission": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Required Permission",
            "type": "string"
          },
          "route": {
            "maxLength": 200,
            "pattern": "^/[A-Za-z0-9/_\\-:\\[\\]]*$",
            "title": "Route",
            "type": "string"
          }
        },
        "required": [
          "route",
          "menu_label",
          "required_permission"
        ],
        "title": "UiAreaDef",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "device-gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/mowdeck-module": {
      "get": {
        "operationId": "module_descriptor__well_known_mowdeck_module_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDescriptor"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Module Descriptor",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/device-gateway/mowers": {
      "get": {
        "description": "Mowers held by this instance with connection status and last activity.\n\nPrincipals bound to an account see only that account's mowers; operators and services\n(no account) see all mowers of the shard.",
        "operationId": "list_mowers_api_v1_device_gateway_mowers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeldMowers"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Mowers",
        "tags": [
          "device-gateway"
        ]
      }
    }
  }
}
