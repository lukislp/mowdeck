{
  "components": {
    "schemas": {
      "ActionKind": {
        "description": "What a proposal can contain.",
        "enum": [
          "start_now",
          "start_later",
          "pause",
          "resume",
          "dock"
        ],
        "title": "ActionKind",
        "type": "string"
      },
      "ActionOut": {
        "description": "One validated action: exactly what the web app executes after the user confirmed.",
        "properties": {
          "area_ids": {
            "description": "`start_now`/`start_later`: the areas in mowing order (every area when the user named none); empty for the other kinds.",
            "items": {
              "type": "string"
            },
            "title": "Area Ids",
            "type": "array"
          },
          "areas": {
            "items": {
              "$ref": "#/components/schemas/AreaOut"
            },
            "title": "Areas",
            "type": "array"
          },
          "duration_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "`start_later`: the time window.",
            "title": "Duration Minutes"
          },
          "kind": {
            "$ref": "#/components/schemas/ActionKind"
          },
          "start_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`start_later`: the UTC start.",
            "title": "Start At"
          },
          "start_local": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "`start_later`: the start as `YYYY-MM-DDTHH:MM` in `timezone`.",
            "title": "Start Local"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "required": [
          "kind",
          "area_ids",
          "areas",
          "start_at",
          "start_local",
          "timezone",
          "duration_minutes"
        ],
        "title": "ActionOut",
        "type": "object"
      },
      "AreaOut": {
        "description": "A map area of the mower.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "AreaOut",
        "type": "object"
      },
      "EventDef": {
        "description": "An event type a module publishes.",
        "properties": {
          "schema_ref": {
            "description": "Reference to the payload JSON Schema (URI or package path).",
            "minLength": 1,
            "title": "Schema Ref",
            "type": "string"
          },
          "type": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Type",
            "type": "string"
          },
          "version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "schema_ref"
        ],
        "title": "EventDef",
        "type": "object"
      },
      "FeatureDef": {
        "description": "A plan feature a module offers, e.g. ``reports``.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "FeatureDef",
        "type": "object"
      },
      "ModuleDescriptor": {
        "description": "Self-description of a service, served at ``/.well-known/mowdeck-module``.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventDef"
            },
            "title": "Events",
            "type": "array"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureDef"
            },
            "title": "Features",
            "type": "array"
          },
          "name": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9\\-]*$",
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/PermissionDef"
            },
            "title": "Permissions",
            "type": "array"
          },
          "ui_areas": {
            "items": {
              "$ref": "#/components/schemas/UiAreaDef"
            },
            "title": "Ui Areas",
            "type": "array"
          },
          "version": {
            "maxLength": 64,
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.\\-+]+)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModuleDescriptor",
        "type": "object"
      },
      "Note": {
        "description": "Why (part of) a request has no action, as the model or the phrase parser reports it.\n\nThe web app explains each in the user's language; free text from the model is never\nshown (it could carry injected instructions or links).",
        "enum": [
          "manual_drive",
          "settings",
          "timed_resume",
          "other_mower",
          "unsupported",
          "unclear"
        ],
        "title": "Note",
        "type": "string"
      },
      "PermissionDef": {
        "description": "A permission a module defines, e.g. ``mower.control``.\n\nKeys that have a relation in the authorization model are checked per object in OpenFGA.\nOther keys are coarse, account-wide permissions carried in the access token (``perms``) and\nchecked with ``require_permission``. ``implied_by`` lets such a key follow an existing one:\nwhoever holds every listed key on the whole account also holds this key.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "implied_by": {
            "description": "Keys that imply this one when held on the whole account (e.g. `device_gateway.view` implied by `mower.view`).",
            "items": {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            "title": "Implied By",
            "type": "array"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "PermissionDef",
        "type": "object"
      },
      "ProposalIn": {
        "additionalProperties": false,
        "description": "``POST /mowers/{mower_id}/proposals``: one request in the user's words.",
        "properties": {
          "text": {
            "description": "What the user typed.",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "timezone": {
            "description": "IANA time zone of the user (the browser's): times like \"tomorrow 8:00\" are meant in it, and a one-off start is scheduled in it.",
            "maxLength": 64,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "text",
          "timezone"
        ],
        "title": "ProposalIn",
        "type": "object"
      },
      "ProposalOut": {
        "description": "The validated proposal for one request. Nothing has been executed.\n\n``executable`` is true only when every action passed validation (all or nothing); then the\nweb app shows the actions on a confirmation card and, after the user confirmed, sends them\nthrough Fleet's command and the Scheduler's schedule endpoints with the user's token.",
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/ActionOut"
            },
            "title": "Actions",
            "type": "array"
          },
          "areas": {
            "description": "Every map area of the mower.",
            "items": {
              "$ref": "#/components/schemas/AreaOut"
            },
            "title": "Areas",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "executable": {
            "title": "Executable",
            "type": "boolean"
          },
          "expires_at": {
            "description": "Execute before this time, else ask again.",
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "interpreter": {
            "enum": [
              "provider",
              "phrases"
            ],
            "title": "Interpreter",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "mower_id": {
            "format": "uuid",
            "title": "Mower Id",
            "type": "string"
          },
          "mower_name": {
            "title": "Mower Name",
            "type": "string"
          },
          "notes": {
            "description": "Why (part of) the request has no action.",
            "items": {
              "$ref": "#/components/schemas/Note"
            },
            "title": "Notes",
            "type": "array"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/RejectedOut"
            },
            "title": "Rejected",
            "type": "array"
          },
          "unavailable": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Unavailable"
            },
            "description": "Kinds not offered for this mower right now, with the reason.",
            "propertyNames": {
              "$ref": "#/components/schemas/ActionKind"
            },
            "title": "Unavailable",
            "type": "object"
          }
        },
        "required": [
          "mower_id",
          "mower_name",
          "interpreter",
          "model",
          "executable",
          "actions",
          "rejected",
          "notes",
          "unavailable",
          "areas",
          "created_at",
          "expires_at"
        ],
        "title": "ProposalOut",
        "type": "object"
      },
      "RejectedOut": {
        "description": "An action of the interpretation that the validator refused.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Rejection"
          },
          "kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionKind"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "kind"
        ],
        "title": "RejectedOut",
        "type": "object"
      },
      "Rejection": {
        "description": "Why one action of the model's answer was refused by the validator.",
        "enum": [
          "unknown_kind",
          "not_offered",
          "unknown_area",
          "too_many_areas",
          "unexpected_field",
          "time_missing",
          "time_invalid",
          "time_past",
          "time_too_far",
          "duration_invalid",
          "too_many_actions",
          "conflict",
          "malformed"
        ],
        "title": "Rejection",
        "type": "string"
      },
      "StatusOut": {
        "description": "``GET /status``: whether the caller can ask now.",
        "properties": {
          "hosted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "The installation's model, not the caller's own.",
            "title": "Hosted"
          },
          "interpreter": {
            "description": "`provider`: the caller's AI provider (Settings, AI provider); `phrases`: the built-in phrase parser without AI (demo mode or the operator's choice).",
            "enum": [
              "provider",
              "phrases"
            ],
            "title": "Interpreter",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The model a request would use (never a key).",
            "title": "Model"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "no_provider",
                  "provider_unavailable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why not ready: no provider configured (own or the installation's), or the AI provider settings (Vision) are not reachable.",
            "title": "Reason"
          }
        },
        "required": [
          "ready",
          "interpreter",
          "reason",
          "model",
          "hosted"
        ],
        "title": "StatusOut",
        "type": "object"
      },
      "UiAreaDef": {
        "description": "An area the module occupies in the web app shell.",
        "properties": {
          "labels": {
            "description": "Translated menu labels by language tag (e.g. `de`); `menu_label` is the English fallback.",
            "patternProperties": {
              "^[a-z]{2}(-[A-Z]{2})?$": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Labels",
            "type": "object"
          },
          "menu_label": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Menu Label",
            "type": "string"
          },
          "required_permission": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Required Permission",
            "type": "string"
          },
          "route": {
            "maxLength": 200,
            "pattern": "^/[A-Za-z0-9/_\\-:\\[\\]]*$",
            "title": "Route",
            "type": "string"
          }
        },
        "required": [
          "route",
          "menu_label",
          "required_permission"
        ],
        "title": "UiAreaDef",
        "type": "object"
      },
      "Unavailable": {
        "description": "Why a kind is not offered for this mower right now.",
        "enum": [
          "permission",
          "no_areas",
          "state",
          "not_connected"
        ],
        "title": "Unavailable",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "assistant",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/mowdeck-module": {
      "get": {
        "operationId": "module_descriptor__well_known_mowdeck_module_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDescriptor"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Module Descriptor",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/assistant/mowers/{mower_id}/proposals": {
      "post": {
        "description": "Interpret one request for one mower and validate the result against the mower's\nactions, areas and the caller's rights. Answers a proposal; nothing is executed. The text\nis neither stored nor logged.",
        "operationId": "propose_api_v1_assistant_mowers__mower_id__proposals_post",
        "parameters": [
          {
            "in": "path",
            "name": "mower_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Mower Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "The mower does not exist or the caller cannot see it."
          },
          "409": {
            "description": "`assistant-provider-missing`: no AI provider configured."
          },
          "422": {
            "description": "Empty or too long text, or an unknown time zone."
          },
          "429": {
            "description": "`assistant-limit`: the caller's or the provider's limit."
          },
          "502": {
            "description": "`assistant-provider-failed`: the model gave no usable answer."
          },
          "503": {
            "description": "A MowDeck service the assistant reads did not answer."
          }
        },
        "summary": "Propose",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/v1/assistant/status": {
      "get": {
        "description": "Whether the caller can ask now: with the provider interpreter a configured AI provider\n(own or the installation's, Settings, AI provider) is needed; the phrase parser is always\nready.",
        "operationId": "assistant_status_api_v1_assistant_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Assistant Status",
        "tags": [
          "assistant"
        ]
      }
    }
  }
}
