{
  "components": {
    "schemas": {
      "AccountDetailOut": {
        "description": "One account for operators: what applies, the assignment and its history.",
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "account_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name"
          },
          "assigned": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssignedOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective": {
            "$ref": "#/components/schemas/ResolvedOut"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryOut"
            },
            "title": "History",
            "type": "array"
          }
        },
        "required": [
          "account_id",
          "account_name",
          "effective",
          "assigned",
          "history"
        ],
        "title": "AccountDetailOut",
        "type": "object"
      },
      "AccountOut": {
        "description": "An account in the operator list: its assignment and what applies (no mower data).",
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "account_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name"
          },
          "assigned": {
            "$ref": "#/components/schemas/AssignedOut"
          },
          "effective": {
            "$ref": "#/components/schemas/ResolvedOut"
          }
        },
        "required": [
          "account_id",
          "account_name",
          "assigned",
          "effective"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "AccountPageOut": {
        "description": "A page of accounts (``offset``/``limit``).",
        "properties": {
          "billing_enabled": {
            "title": "Billing Enabled",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AccountOut"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit",
          "billing_enabled"
        ],
        "title": "AccountPageOut",
        "type": "object"
      },
      "AssignedOut": {
        "description": "The stored assignment of an account.",
        "properties": {
          "grace_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grace Until"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "since": {
            "format": "date-time",
            "title": "Since",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PlanSource"
          },
          "status": {
            "$ref": "#/components/schemas/PlanStatus",
            "description": "Stored status (time does not change it)."
          },
          "trial_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Until"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "plan",
          "status",
          "source",
          "since",
          "trial_until",
          "grace_until",
          "updated_at"
        ],
        "title": "AssignedOut",
        "type": "object"
      },
      "AssignmentIn": {
        "additionalProperties": false,
        "description": "Body of ``PUT /accounts/{id}/plan``.",
        "properties": {
          "account_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name"
          },
          "grace_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "End of a grace period; default now plus the grace days.",
            "title": "Grace Until"
          },
          "plan": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Plan",
            "type": "string"
          },
          "reason": {
            "description": "Why (kept in the history).",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PlanStatus",
            "default": "active"
          },
          "trial_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "End of a trial; default now plus the plan's trial days.",
            "title": "Trial Until"
          }
        },
        "required": [
          "plan",
          "reason"
        ],
        "title": "AssignmentIn",
        "type": "object"
      },
      "EventDef": {
        "description": "An event type a module publishes.",
        "properties": {
          "schema_ref": {
            "description": "Reference to the payload JSON Schema (URI or package path).",
            "minLength": 1,
            "title": "Schema Ref",
            "type": "string"
          },
          "type": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Type",
            "type": "string"
          },
          "version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "schema_ref"
        ],
        "title": "EventDef",
        "type": "object"
      },
      "FeatureDef": {
        "description": "A plan feature a module offers, e.g. ``reports``.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "FeatureDef",
        "type": "object"
      },
      "FeatureOut": {
        "description": "A feature of the catalogue.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "module": {
            "title": "Module",
            "type": "string"
          },
          "retired": {
            "title": "Retired",
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "description",
          "module",
          "retired"
        ],
        "title": "FeatureOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryOut": {
        "description": "One assignment.",
        "properties": {
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "grace_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grace Until"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "source": {
            "$ref": "#/components/schemas/PlanSource"
          },
          "status": {
            "$ref": "#/components/schemas/PlanStatus"
          },
          "trial_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Until"
          }
        },
        "required": [
          "at",
          "plan",
          "status",
          "source",
          "reason",
          "actor",
          "trial_until",
          "grace_until"
        ],
        "title": "HistoryOut",
        "type": "object"
      },
      "ModuleDescriptor": {
        "description": "Self-description of a service, served at ``/.well-known/mowdeck-module``.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventDef"
            },
            "title": "Events",
            "type": "array"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureDef"
            },
            "title": "Features",
            "type": "array"
          },
          "name": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9\\-]*$",
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/PermissionDef"
            },
            "title": "Permissions",
            "type": "array"
          },
          "ui_areas": {
            "items": {
              "$ref": "#/components/schemas/UiAreaDef"
            },
            "title": "Ui Areas",
            "type": "array"
          },
          "version": {
            "maxLength": 64,
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.\\-+]+)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModuleDescriptor",
        "type": "object"
      },
      "PermissionDef": {
        "description": "A permission a module defines, e.g. ``mower.control``.\n\nKeys that have a relation in the authorization model are checked per object in OpenFGA.\nOther keys are coarse, account-wide permissions carried in the access token (``perms``) and\nchecked with ``require_permission``. ``implied_by`` lets such a key follow an existing one:\nwhoever holds every listed key on the whole account also holds this key.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "implied_by": {
            "description": "Keys that imply this one when held on the whole account (e.g. `device_gateway.view` implied by `mower.view`).",
            "items": {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            "title": "Implied By",
            "type": "array"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "PermissionDef",
        "type": "object"
      },
      "PlanDetailOut": {
        "description": "A plan for operators: also the features no module declares and where it came from.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "features": {
            "description": "Feature keys; `*` grants every feature.",
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "from_plan_file": {
            "description": "Seeded from the plan file (a changed file entry overwrites it at the next start).",
            "title": "From Plan File",
            "type": "boolean"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits",
            "description": "Limits; null means unlimited."
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "trial_days": {
            "title": "Trial Days",
            "type": "integer"
          },
          "unknown_features": {
            "description": "Feature keys of the plan that no module declares (kept, they gate nothing until a module enforcing them is deployed).",
            "items": {
              "type": "string"
            },
            "title": "Unknown Features",
            "type": "array"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "limits",
          "features",
          "trial_days",
          "is_default",
          "active",
          "unknown_features",
          "from_plan_file",
          "created_at",
          "updated_at"
        ],
        "title": "PlanDetailOut",
        "type": "object"
      },
      "PlanIn": {
        "additionalProperties": false,
        "description": "Body of ``PUT /plans/{key}``: the whole plan.",
        "properties": {
          "active": {
            "default": true,
            "title": "Active",
            "type": "boolean"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "features": {
            "items": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
                  "type": "string"
                },
                {
                  "pattern": "^\\*$",
                  "type": "string"
                }
              ]
            },
            "maxItems": 500,
            "title": "Features",
            "type": "array"
          },
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "trial_days": {
            "default": 0,
            "maximum": 365.0,
            "minimum": 0.0,
            "title": "Trial Days",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "PlanIn",
        "type": "object"
      },
      "PlanLimits": {
        "description": "The limits of a plan; ``None`` means unlimited.",
        "properties": {
          "history_days": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "History Days"
          },
          "max_groups": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Groups"
          },
          "max_mowers": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Mowers"
          },
          "max_schedules": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Schedules"
          },
          "max_sites": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Sites"
          },
          "max_users": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Users"
          }
        },
        "title": "PlanLimits",
        "type": "object"
      },
      "PlanOut": {
        "description": "A plan as offered.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "features": {
            "description": "Feature keys; `*` grants every feature.",
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits",
            "description": "Limits; null means unlimited."
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "trial_days": {
            "title": "Trial Days",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "limits",
          "features",
          "trial_days",
          "is_default",
          "active"
        ],
        "title": "PlanOut",
        "type": "object"
      },
      "PlanSource": {
        "description": "Who set an account's plan.",
        "enum": [
          "default",
          "manual",
          "billing"
        ],
        "title": "PlanSource",
        "type": "string"
      },
      "PlanStatus": {
        "description": "Status of an account's plan.",
        "enum": [
          "active",
          "trial",
          "grace",
          "expired"
        ],
        "title": "PlanStatus",
        "type": "string"
      },
      "ResolvedOut": {
        "description": "The plan that applies to an account now.",
        "properties": {
          "account_id": {
            "format": "uuid",
            "title": "Account Id",
            "type": "string"
          },
          "billing_enabled": {
            "description": "False: billing is disabled on this installation and every account has the plan `unlimited`, whatever was assigned.",
            "title": "Billing Enabled",
            "type": "boolean"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "grace_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grace Until"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "plan_name": {
            "title": "Plan Name",
            "type": "string"
          },
          "since": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          },
          "source": {
            "$ref": "#/components/schemas/PlanSource"
          },
          "status": {
            "$ref": "#/components/schemas/PlanStatus",
            "description": "Effective status (an ended trial is `expired`)."
          },
          "trial_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Until"
          }
        },
        "required": [
          "account_id",
          "plan",
          "plan_name",
          "status",
          "source",
          "billing_enabled",
          "limits",
          "features"
        ],
        "title": "ResolvedOut",
        "type": "object"
      },
      "UiAreaDef": {
        "description": "An area the module occupies in the web app shell.",
        "properties": {
          "labels": {
            "description": "Translated menu labels by language tag (e.g. `de`); `menu_label` is the English fallback.",
            "patternProperties": {
              "^[a-z]{2}(-[A-Z]{2})?$": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Labels",
            "type": "object"
          },
          "menu_label": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Menu Label",
            "type": "string"
          },
          "required_permission": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Required Permission",
            "type": "string"
          },
          "route": {
            "maxLength": 200,
            "pattern": "^/[A-Za-z0-9/_\\-:\\[\\]]*$",
            "title": "Route",
            "type": "string"
          }
        },
        "required": [
          "route",
          "menu_label",
          "required_permission"
        ],
        "title": "UiAreaDef",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "entitlements",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/mowdeck-module": {
      "get": {
        "operationId": "module_descriptor__well_known_mowdeck_module_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDescriptor"
                }
              }
            },
            "description": "Successful Response"
