{
  "components": {
    "schemas": {
      "BillingStatusOut": {
        "description": "``GET /status``: billing runs in this installation and what it sells.\n\nThe service only runs when billing is enabled, so a reachable endpoint always says\n``enabled: true``; the web app treats a network error or 404 as \"billing disabled\".",
        "properties": {
          "automatic_tax": {
            "description": "Stripe Tax calculates VAT in Checkout.",
            "title": "Automatic Tax",
            "type": "boolean"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "plans": {
            "items": {
              "$ref": "#/components/schemas/StatusPlanOut"
            },
            "title": "Plans",
            "type": "array"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "currency",
          "automatic_tax",
          "plans"
        ],
        "title": "BillingStatusOut",
        "type": "object"
      },
      "CheckoutIn": {
        "additionalProperties": false,
        "description": "Body of ``POST /checkout``.",
        "properties": {
          "plan": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "title": "Plan",
            "type": "string"
          }
        },
        "required": [
          "plan"
        ],
        "title": "CheckoutIn",
        "type": "object"
      },
      "EventDef": {
        "description": "An event type a module publishes.",
        "properties": {
          "schema_ref": {
            "description": "Reference to the payload JSON Schema (URI or package path).",
            "minLength": 1,
            "title": "Schema Ref",
            "type": "string"
          },
          "type": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Type",
            "type": "string"
          },
          "version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "type",
          "schema_ref"
        ],
        "title": "EventDef",
        "type": "object"
      },
      "FeatureDef": {
        "description": "A plan feature a module offers, e.g. ``reports``.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "FeatureDef",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvoiceOut": {
        "description": "An invoice reference; the document itself stays at the provider.",
        "properties": {
          "amount_due": {
            "description": "Cents.",
            "title": "Amount Due",
            "type": "integer"
          },
          "amount_paid": {
            "description": "Cents.",
            "title": "Amount Paid",
            "type": "integer"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "hosted_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hosted Url"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "pdf_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdf Url"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "number",
          "status",
          "currency",
          "amount_due",
          "amount_paid",
          "issued_at",
          "hosted_url",
          "pdf_url"
        ],
        "title": "InvoiceOut",
        "type": "object"
      },
      "ModuleDescriptor": {
        "description": "Self-description of a service, served at ``/.well-known/mowdeck-module``.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventDef"
            },
            "title": "Events",
            "type": "array"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureDef"
            },
            "title": "Features",
            "type": "array"
          },
          "name": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9\\-]*$",
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/PermissionDef"
            },
            "title": "Permissions",
            "type": "array"
          },
          "ui_areas": {
            "items": {
              "$ref": "#/components/schemas/UiAreaDef"
            },
            "title": "Ui Areas",
            "type": "array"
          },
          "version": {
            "maxLength": 64,
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.\\-+]+)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModuleDescriptor",
        "type": "object"
      },
      "PermissionDef": {
        "description": "A permission a module defines, e.g. ``mower.control``.\n\nKeys that have a relation in the authorization model are checked per object in OpenFGA.\nOther keys are coarse, account-wide permissions carried in the access token (``perms``) and\nchecked with ``require_permission``. ``implied_by`` lets such a key follow an existing one:\nwhoever holds every listed key on the whole account also holds this key.",
        "properties": {
          "description": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "implied_by": {
            "description": "Keys that imply this one when held on the whole account (e.g. `device_gateway.view` implied by `mower.view`).",
            "items": {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            "title": "Implied By",
            "type": "array"
          },
          "key": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Key",
            "type": "string"
          }
        },
        "required": [
          "key",
          "description"
        ],
        "title": "PermissionDef",
        "type": "object"
      },
      "PlanStatus": {
        "description": "Status of an account's plan.",
        "enum": [
          "active",
          "trial",
          "grace",
          "expired"
        ],
        "title": "PlanStatus",
        "type": "string"
      },
      "PriceOut": {
        "description": "A provider price; amounts in the smallest currency unit (cents).",
        "properties": {
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 4217, lower case; null when not fetched.",
            "title": "Currency"
          },
          "interval": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "day, week, month or year.",
            "title": "Interval"
          },
          "interval_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Count"
          },
          "price_id": {
            "title": "Price Id",
            "type": "string"
          },
          "unit_amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Amount per interval in cents.",
            "title": "Unit Amount"
          }
        },
        "required": [
          "price_id",
          "currency",
          "unit_amount",
          "interval",
          "interval_count"
        ],
        "title": "PriceOut",
        "type": "object"
      },
      "RedirectOut": {
        "description": "A provider page to send the browser to.",
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "RedirectOut",
        "type": "object"
      },
      "StatusPlanOut": {
        "description": "A plan on sale.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "From Entitlements; null when it is not reachable.",
            "title": "Name"
          },
          "price": {
            "$ref": "#/components/schemas/PriceOut"
          },
          "trial_days": {
            "description": "Trial of a first subscription (from Entitlements).",
            "title": "Trial Days",
            "type": "integer"
          }
        },
        "required": [
          "key",
          "name",
          "description",
          "trial_days",
          "price"
        ],
        "title": "StatusPlanOut",
        "type": "object"
      },
      "SubscriptionOut": {
        "description": "A subscription as the provider last reported it.",
        "properties": {
          "cancel_at_period_end": {
            "title": "Cancel At Period End",
            "type": "boolean"
          },
          "current_period_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Period End"
          },
          "grace_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grace Until"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          },
          "plan_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "What Billing set in Entitlements."
          },
          "status": {
            "$ref": "#/components/schemas/SubscriptionStatus"
          },
          "trial_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial End"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "plan",
          "status",
          "plan_status",
          "current_period_end",
          "trial_end",
          "grace_until",
          "cancel_at_period_end",
          "updated_at"
        ],
        "title": "SubscriptionOut",
        "type": "object"
      },
      "SubscriptionStatus": {
        "description": "Status of a subscription at the payment provider (Stripe's values).",
        "enum": [
          "incomplete",
          "incomplete_expired",
          "trialing",
          "active",
          "past_due",
          "canceled",
          "unpaid",
          "paused"
        ],
        "title": "SubscriptionStatus",
        "type": "string"
      },
      "SubscriptionSummaryOut": {
        "description": "``GET /subscription``: the account's subscription (null before the first checkout).",
        "properties": {
          "has_customer": {
            "description": "The portal can be opened.",
            "title": "Has Customer",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "subscription": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubscriptionOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "has_customer",
          "subscription"
        ],
        "title": "SubscriptionSummaryOut",
        "type": "object"
      },
      "UiAreaDef": {
        "description": "An area the module occupies in the web app shell.",
        "properties": {
          "labels": {
            "description": "Translated menu labels by language tag (e.g. `de`); `menu_label` is the English fallback.",
            "patternProperties": {
              "^[a-z]{2}(-[A-Z]{2})?$": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Labels",
            "type": "object"
          },
          "menu_label": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Menu Label",
            "type": "string"
          },
          "required_permission": {
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "title": "Required Permission",
            "type": "string"
          },
          "route": {
            "maxLength": 200,
            "pattern": "^/[A-Za-z0-9/_\\-:\\[\\]]*$",
            "title": "Route",
            "type": "string"
          }
        },
        "required": [
          "route",
          "menu_label",
          "required_permission"
        ],
        "title": "UiAreaDef",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebhookOut": {
        "description": "Answer to the provider: received (and what it did, for the logs of the provider).",
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "received": {
            "default": true,
            "title": "Received",
            "type": "boolean"
          }
        },
        "required": [
          "event_id",
          "outcome",
          "duplicate"
        ],
        "title": "WebhookOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "billing",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/mowdeck-module": {
      "get": {
        "operationId": "module_descriptor__well_known_mowdeck_module_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModuleDescriptor"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Module Descriptor",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/billing/checkout": {
      "post": {
        "description": "Start a hosted checkout for ``plan``; redirect the browser to ``url``.\n\n422 when the plan is not sold here, 409 when the account already has a subscription (plan\nchanges and cancellation happen in the customer portal).",
        "operationId": "checkout_api_v1_billing_checkout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedirectOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Checkout",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/billing/invoices": {
      "get": {
        "description": "The newest invoices of the caller's account (links to the provider's pages).",
        "operationId": "invoices_api_v1_billing_invoices_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InvoiceOut"
                  },
                  "title": "Response Invoices Api V1 Billing Invoices Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Invoices",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/billing/portal": {
      "post": {
        "description": "Open the provider's customer portal (payment method, invoices, plan change, cancel).\n\n404 before the account's first checkout.",
        "operationId": "portal_api_v1_billing_portal_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedirectOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Portal",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/billing/status": {
      "get": {
        "description": "Billing runs here: the provider, the currency and the plans on sale with prices.\n\nPublic (a pricing view needs no login). The web app probes it: a network error or 404\n(the service is not deployed, billing is disabled) hides every billing element.",
        "operationId": "status_api_v1_billing_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingStatusOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/billing/subscription": {
      "get": {
        "description": "The subscription of the caller's account (``subscription: null`` before checkout).",
        "operationId": "subscription_api_v1_billing_subscription_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionSummaryOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Subscription",
        "tags": [
          "billing"
        ]
      }
    },
    "/api/v1/billing/webhooks/stripe": {
      "post": {
        "description": "Stripe events. No token: only the ``Stripe-Signature`` over the raw body counts.\n\n400 for an invalid signature, 200 for a handled or repeated event (each event id is\nprocessed once), 500 when handling failed (Stripe retries).",
        "operationId": "stripe_webhook_api_v1_billing_webhooks_stripe_post",
        "parameters": [
          {
            "in": "header",
            "name": "stripe-signature",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stripe-Signature"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stripe Webhook",
        "tags": [
          "billing"
        ]
      }
    }
  }
}
