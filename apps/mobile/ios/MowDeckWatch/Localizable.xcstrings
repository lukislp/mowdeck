    },
    "Add a mower in MowDeck.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a mower in MowDeck."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in MowDeck einen Mäher hinzu."
          }
        }
      }
    },
    "Asks for confirmation, then stops blades and wheels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for confirmation, then stops blades and wheels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt nach einer Bestätigung und stoppt dann Messer und Räder."
          }
        }
      }
    },
