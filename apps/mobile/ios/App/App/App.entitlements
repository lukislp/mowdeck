<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability (paid developer account). A development provisioning
	     profile (direct install from the Mac) always yields "development", i.e. the APNs sandbox;
	     the server must use MOWDECK_APNS_ENVIRONMENT=development. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Theft alarms are sent as time-sensitive notifications (they break through Focus). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Widgets and the Live Activity (ADR 0059): the App Group shared with the widget extension and
	     the Keychain group of the widget credential. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.mowdeck.mobile</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.mowdeck.mobile.shared</string>
	</array>
</dict>
</plist>
