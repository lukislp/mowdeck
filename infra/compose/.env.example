# Copy to .env and adjust. NEVER commit the real .env file.
# All values below are development defaults only.

# --- Image sources (the one list of pinned third-party images) ---
# Pinned public images without a login (bump deliberately): the Dockerfile and Compose defaults,
# the Helm chart and the CI workflows must match these lines (tools/repo-checks/tests/
# test_images.py). Point them at another registry or a mirror of your own by changing the
# values, or all at once with `MOWDECK_IMAGE_MIRROR=<registry/prefix> sh infra/mirror-env.sh
# >> .env` (infra/compose/README.md, "Image sources"). CI pulls every line through the
# repository's GHCR mirror ghcr.io/<owner>/mowdeck/mirror/<alias>:<tag>, filled from this list
# by .github/workflows/mirror-images.yml; the stack at home pulls the public images below.
# Infrastructure the stack runs:
TRAEFIK_IMAGE=public.ecr.aws/docker/library/traefik:v3.7.14
NATS_IMAGE=public.ecr.aws/docker/library/nats:2.15.0-alpine
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:17.11-alpine
OPENFGA_IMAGE=ghcr.io/openfga/openfga:v1.22.0
WHOAMI_IMAGE=ghcr.io/traefik/whoami:v1.10.3
# Base images the MowDeck images are built from (build arguments of the Dockerfiles):
PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.13-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.24
NODE_IMAGE=public.ecr.aws/docker/library/node:22.23.3-alpine
NGINX_IMAGE=public.ecr.aws/nginx/nginx-unprivileged:1.30.5-alpine
BUSYBOX_IMAGE=public.ecr.aws/docker/library/busybox:1.37.0
FGA_CLI_IMAGE=openfga/cli:v0.8.1
JQ_IMAGE=ghcr.io/jqlang/jq:1.8.1
# Images only the CI integration tests run (the stack never starts them), listed here so that the
# mirror and the checks have one list:
NTFY_IMAGE=binwiederhier/ntfy:v2.28.0
STRIPE_MOCK_IMAGE=stripe/stripe-mock:v0.206.0

# --- Compose network ---
# Name of the Docker network the stack and Traefik use. Give a second stack on the same host its
# own name (`docker compose -p other ...` with MOWDECK_NETWORK=other, MOWDECK_TRAEFIK_PROJECT=other
# and other host ports) so the two do not see each other's containers.
MOWDECK_NETWORK=mowdeck
# Compose project whose containers this Traefik routes (the -p name; default mowdeck).
MOWDECK_TRAEFIK_PROJECT=mowdeck

# --- Host ports (databases and buses are bound to 127.0.0.1 only) ---
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
POSTGRES_PORT=5432
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
OPENFGA_HTTP_PORT=8080
OPENFGA_GRPC_PORT=8081

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
# Shared password for the per-service roles (identity, fleet, ...). Use one
# password per role in production deployments.
SERVICE_DB_PASSWORD=change-me-service

# --- OpenFGA ---
# Pre-shared API key for the OpenFGA HTTP/gRPC API (dev default; change it).
# Several keys may be given comma separated (key rotation); then set
# OPENFGA_API_TOKEN to the one the stack's clients use.
OPENFGA_AUTHN_PRESHARED_KEYS=change-me-openfga-key
# URL under which services and the authz-bootstrap job reach OpenFGA.
OPENFGA_API_URL=http://openfga:8080
# Key used by authz-bootstrap and the services (default: OPENFGA_AUTHN_PRESHARED_KEYS).
# OPENFGA_API_TOKEN=
# Store the bootstrap job creates and services resolve by name.
OPENFGA_STORE_NAME=mowdeck

# --- MowDeck services ---
# Tag of the locally built service images (mowdeck/<service>:<tag>).
MOWDECK_VERSION=dev
MOWDECK_ENVIRONMENT=dev
MOWDECK_LOG_LEVEL=INFO

# --- Identity ---
# DEVELOPMENT DEFAULT ONLY: the 256-bit key that encrypts the token signing
# keys at rest (base64; it decodes to "dev-only-key-encryption-key-0000").
# Generate your own for any real installation:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
IDENTITY_KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24ta2V5LTAwMDA=
# open: anybody may register (home installation default); closed: only the
# first account, then 403 (more owners: python -m identity.cli create-user).
IDENTITY_REGISTRATION=open
# rfc9106_low (64 MiB, t=3, p=4) or owasp_min (19 MiB, t=2, p=1) for small hosts.
IDENTITY_ARGON2_PROFILE=rfc9106_low
# Plain HTTP in development; set to true behind HTTPS.
IDENTITY_REFRESH_COOKIE_SECURE=false

# --- Fleet ---
# Connection kinds accepted when a mower is registered: simulated, and the real
# Mammotion adapters cloud and ble_bridge (in the Device-Gateway image). The web
# app offers exactly these (GET /api/v1/fleet/connection-kinds); set simulated
# alone to hide the real kinds.
FLEET_ALLOWED_CONNECTION_KINDS=simulated,cloud,ble_bridge
# DEVELOPMENT ONLY - NEVER USE THIS VALUE IN A REAL INSTALLATION: the 256-bit key that
# encrypts the passwords of linked Mammotion accounts at rest (base64; it decodes to
# "dev-only-fleet-credential-key-00"; Fleet refuses it with MOWDECK_ENVIRONMENT=prod).
# Empty: Fleet starts, but linking a Mammotion account answers 503, so no cloud mower can be
# added. Generate your own and keep a backup (without it the stored passwords are lost):
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
FLEET_CREDENTIAL_ENCRYPTION_KEY=ZGV2LW9ubHktZmxlZXQtY3JlZGVudGlhbC1rZXktMDA=
# Key rotation: the old key(s), comma separated, that may still decrypt; the next re-read of
# a linked account seals its password with FLEET_CREDENTIAL_ENCRYPTION_KEY.
FLEET_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# How long Fleet waits for the route a mower plans for a path preview
# (POST /mowers/{id}/path-preview; 504 after). The timeouts must stay ordered:
# GATEWAY_PATH_PREVIEW_TIMEOUT_SECONDS (75) < FLEET_PATH_PREVIEW_REQUEST_TIMEOUT_SECONDS (85)
# < the web app's 90 s, so each layer reports its own timeout.
FLEET_PATH_PREVIEW_REQUEST_TIMEOUT_SECONDS=85

# --- Device-Gateway ---
# DEVELOPMENT ONLY: answer linked account logins and connect cloud mowers through the fake
# Mammotion cloud (accounts *@fake.mowdeck.test, password fake-cloud-password) instead of
# the real one. The browser tests (tests/e2e-web/stack.env) switch it on.
GATEWAY_FAKE_MAMMOTION_CLOUD=false

# --- Telemetry ---
# Latest state, history, position track and command timeline of every mower.
# An unchanged state is stored in the history at most once per this many seconds.
TELEMETRY_HEARTBEAT_HISTORY_SECONDS=300
# Retention in days (a job under an advisory lock deletes older rows).
TELEMETRY_RETENTION_HISTORY_DAYS=30
TELEMETRY_RETENTION_POSITIONS_DAYS=90
TELEMETRY_RETENTION_COMMANDS_DAYS=30
# Health history: remind to change the blades after this many blade hours since the last change.
TELEMETRY_BLADE_HOURS_THRESHOLD=50

# --- Realtime ---
# WebSocket protocol pings (seconds) that keep idle sockets open through Traefik.
REALTIME_PING_SECONDS=20
# Open sockets per account and per user on one instance (one more: close 4429).
REALTIME_MAX_CONNECTIONS_PER_ACCOUNT=50
REALTIME_MAX_CONNECTIONS_PER_USER=10
# Comma separated Origin values allowed to open a socket (empty: any origin). The
# web app is served by this stack at the gateway's origin; add the address you open
# it with (for example https://mowdeck.<tailnet>.ts.net) when it is not localhost.
# A phone on your LAN opens it with the computer's LAN address: add that too, for
# example http://localhost,http://192.168.1.20 (a refused socket is logged by realtime
# at info level with its origin: "websocket refused: origin not allowed").
REALTIME_ALLOWED_ORIGINS=http://localhost
# Manual driving (joystick): a drive session ends after this many seconds.
REALTIME_DRIVE_MAX_SECONDS=600

# --- Web app ---
# Optional raster tiles under the map, as a URL template with {z}, {x}, {y} (and {s}).
# Empty (the default): the map draws a metric grid in the mower's local frame and no
# request leaves this installation. With tiles every map view sends the tile coordinates,
# that is the location of the garden, and the viewer's IP address to the tile server.
# Respect the provider's usage policy (the public OpenStreetMap servers are not meant
# for apps: https://operations.osmfoundation.org/policies/tiles/) and set the
# attribution it requires.
WEB_MAP_TILES=
WEB_MAP_ATTRIBUTION=
WEB_MAP_MAX_ZOOM=19
# Links to the legal pages (/legal/imprint, /legal/terms, /legal/privacy) on the login page.
# The shipped pages are placeholders with a visible banner: replace them before enabling this
# for a public installation (docs/ops/billing.md).
WEB_LEGAL_ENABLED=false
# Live camera of cloud mowers (ADR 0032): true lets the browser join the mower's video on
# Agora's servers (the CSP then allows *.agora.io and *.sd-rtn.com). The video and the
# viewer's IP address go to Agora and Mammotion; over 4G it counts against the mower's
# video allowance. false (the default): no third-party video; the simulator's test pattern
# works either way.
WEB_CAMERA_ENABLED=false

# --- Device-Gateway ---
# The gateway loads its mowers from Fleet (register them through the Fleet API).
# MOWDECK_BOOTSTRAP_MOWERS stays a development-only setting of the service for
# running it without Fleet; it is not passed by this stack.
# Simulated seconds per real second (30: a lawn is mown in minutes, not hours).
MOWDECK_SIM_TIME_SCALE=30
MOWDECK_TELEMETRY_HEARTBEAT_SECONDS=10
# Longest time the gateway lets a mower plan a path preview (planning, then fetching the
# line list; over 4G up to about a minute). Keep it below Fleet's
# FLEET_PATH_PREVIEW_REQUEST_TIMEOUT_SECONDS (75 < 85 < 90 s of the web app), so Fleet gets
# the gateway's "timeout" reply instead of running into its own.
GATEWAY_PATH_PREVIEW_TIMEOUT_SECONDS=75

# --- Notifications ---
# Channels the service enables (log writes every message to the service log).
NOTIFICATIONS_CHANNELS=webpush,ntfy,apns,log
# Web Push (VAPID). Empty: a DEVELOPMENT key pair is created in the
# notifications-data volume on first start and its public key is logged.
# Production: generate a pair once and set both (keep the private key secret):
#   docker compose run --rm notifications python -m notifications.cli generate-vapid-keys
NOTIFICATIONS_VAPID_PRIVATE_KEY=
NOTIFICATIONS_VAPID_PUBLIC_KEY=
# Contact of the operator for push services (mailto: or https:).
NOTIFICATIONS_VAPID_SUBJECT=mailto:admin@localhost.localdomain
# ntfy servers users may choose (comma separated origins; empty disables ntfy).
NOTIFICATIONS_NTFY_ALLOWED_SERVERS=https://ntfy.sh
# Public URL of the web app for links in notifications (empty: relative links).
NOTIFICATIONS_APP_URL=
# APNs (push to the iOS app, token based, no Firebase). Create a key with the
# "Apple Push Notifications service" capability in the Apple Developer account,
# put AuthKey_<KEY_ID>.p8 into infra/compose/secrets/apns/ (git-ignored) and
# point APNS_KEY_FILE at it inside the container. Empty: the apns channel is off.
#   APNS_KEY_FILE=/run/secrets/apns/AuthKey_ABC123DEFG.p8
APNS_KEY_FILE=
# Key ID (10 characters) and Team ID (10 characters) from the developer account.
APNS_KEY_ID=
APNS_TEAM_ID=
# Bundle ID of the iOS app (the apns-topic).
APNS_BUNDLE_ID=app.mowdeck.mobile
# development: api.sandbox.push.apple.com (builds installed from Xcode with a
# development profile); production: api.push.apple.com (TestFlight, App Store).
APNS_ENVIRONMENT=development
# Rules: offline after this many seconds without a state, battery threshold in
# percent, shortest mowing job (wall clock) that counts as "finished". The
# service default is 120 s; the simulator at MOWDECK_SIM_TIME_SCALE=30 mows the
# front lawn in well under a minute, so the development stack uses 10 s.
NOTIFICATIONS_OFFLINE_AFTER_SECONDS=120
NOTIFICATIONS_BATTERY_LOW_PERCENT=20
NOTIFICATIONS_MOWING_MIN_SECONDS=10
# Theft alarm: margin around the mapped areas, paths and dock before geofence_exit fires,
# and how long an acknowledged alarm stays silent for that user.
NOTIFICATIONS_GEOFENCE_MARGIN_METERS=5
NOTIFICATIONS_ACK_SILENCE_SECONDS=3600

# --- Entitlements (plans, ADR 0028) ---
# Installation switch of the subscription plans (billing.enabled). false (the default): every
# account has the plan "unlimited" and nothing is gated. true: the plans of
# infra/entitlements/plans.yaml apply (limits such as max_mowers, features such as
# manual_drive), and a check fails closed while Entitlements does not answer. Every service
# reads this switch; restart the stack (or at least entitlements) after changing it.
ENTITLEMENTS_BILLING_ENABLED=false
# Plan of accounts without an assignment while billing is enabled (and of new accounts).
ENTITLEMENTS_DEFAULT_PLAN=home

# --- Scheduler ---
# Weather provider of the rain pause: open_meteo (needs internet access to
# api.open-meteo.com, free for non-commercial use, data CC BY 4.0) or static
# (offline; SCHEDULER_STATIC_WEATHER=dry|rain|unknown is its fixed answer).
SCHEDULER_WEATHER_PROVIDER=open_meteo
SCHEDULER_STATIC_WEATHER=dry
# How often due schedules are fired (seconds).
SCHEDULER_TICK_SECONDS=30
# Development only: PUT /api/v1/scheduler/dev/weather switches the static provider.
SCHEDULER_DEV_ENDPOINTS=false

# --- Billing (subscriptions and payments, ADR 0031, docs/ops/billing.md) ---
# billing.enabled: the Billing service runs only with the Compose profile "billing"
# (COMPOSE_PROFILES=billing, or `--profile billing`). Without it (the default) nothing billing
# related starts and the web app shows no billing elements. Enable it together with
# ENTITLEMENTS_BILLING_ENABLED=true above, otherwise every account keeps the plan "unlimited"
# whatever it pays for. Add http://billing:8000 to Identity's module URLs only when enabled.
# COMPOSE_PROFILES=billing
# Payment provider: stripe, or fake (no network, nothing charged; for a local demo with signed
# fixture webhooks: python -m billing.cli send-fixture).
BILLING_PROVIDER=stripe
# Stripe keys of the operator's account (test mode first: sk_test_..., whsec_...). Never commit
# real values; in production pass them as files (MOWDECK_BILLING_STRIPE_SECRET_KEY_FILE).
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=
# Other Stripe API base (stripe-mock in tests: http://stripe-mock:12111); empty: Stripe.
BILLING_STRIPE_API_BASE=
# Stripe Tax: VAT calculated in Checkout (needs Stripe Tax and the registrations, e.g. OSS).
BILLING_AUTOMATIC_TAX=false
# Stripe price id per plan, overriding infra/billing/prices.yaml: home=price_...,fleet=price_...
BILLING_PRICE_IDS=
# Days after the last paid period before a payment problem ends the plan (status grace).
BILLING_GRACE_DAYS=14
# Public URL of the web app for the return links of Checkout and the portal (empty: the
# request's origin). Set it in production, e.g. https://mowdeck.example.org.
BILLING_APP_URL=

# --- Planner (mowing patterns and spot mowing, ADR 0030) ---
# Cutting width of the mowers in metres (LUBA 2: 0.4); plans space their runs by this minus
# an overlap of 0.05 m. A request may override it per plan.
PLANNER_CUTTING_WIDTH_M=0.4
# Plans computed at the same time per replica (CPU-bound worker threads).
PLANNER_MAX_PARALLEL=2

# --- Vision: AI assist (ADR 0033) ---
# Users configure their own vision model in the web app (Settings, AI provider); keys are
# stored encrypted with VISION_SECRETS_KEY (32 bytes, base64 or hex, e.g. `openssl rand -base64
# 32`). Without it users can only configure keyless providers (Ollama, open endpoints).
VISION_SECRETS_KEY=
# The installation's own model for users without one (plan feature ai_recover_hosted). Any
# LiteLLM model string: anthropic/claude-sonnet-5-5, openai/gpt-5-mini, gemini/gemini-2.5-flash,
# mistral/pixtral-large-latest, ollama/llava (with VISION_DEFAULT_API_BASE=http://ollama:11434),
# openai/<model> with VISION_DEFAULT_API_BASE for any OpenAI-compatible endpoint, or
# fake/recover for an offline demo with the simulator.
VISION_DEFAULT_ENABLED=false
VISION_DEFAULT_MODEL=anthropic/claude-sonnet-5-5
VISION_DEFAULT_API_BASE=
# Key of the installation model (images leave the installation when a cloud model is used).
VISION_DEFAULT_API_KEY=
# Development only: users may pick the fake provider (e2e stack).
VISION_ALLOW_FAKE_PROVIDER=false
# Base URLs users may set: any (home network with Ollama), public (hosted installations), none.
VISION_USER_API_BASE_POLICY=any
VISION_PROPOSAL_TTL_SECONDS=300
VISION_MAX_ROUNDS=3
VISION_USER_DAILY_REQUESTS=20
VISION_HOSTED_ACCOUNT_DAILY_REQUESTS=50
VISION_KEEP_IMAGES_DAYS=0
# Automatic AI analysis on errors (ADR 0035): users opt in on the AI provider page; a mower
# entering a recoverable error (stuck, blocked, outside its area, wheel slip) then gets a
# proposal that still needs an approval. false switches it off for the installation.
VISION_AUTO_ENABLED=true
# No automatic analysis for a mower within this many minutes after the previous analysis.
VISION_AUTO_COOLDOWN_MINUTES=10
# Automatic analyses per mower and UTC day.
VISION_AUTO_DAILY_PER_MOWER=20
# How long Vision waits for the gateway's photo (a real camera through the capture worker
# takes 5 to 15 s); keep it above GATEWAY_PHOTO_TIMEOUT_SECONDS.
VISION_PHOTO_TIMEOUT_SECONDS=35

# --- Capture worker: photos of real cameras without a browser (ADR 0035) ---
# Start it with COMPOSE_PROFILES=capture (it is the Vision image with Chromium, about 0.5 GB
# more) and point the gateway at it: GATEWAY_CAPTURE_URL=http://vision-capture:8000. Empty:
# mowers without an own photo function (the Mammotion cloud) answer photo requests with
# "unsupported", so AI assist needs the camera panel's frame and automatic analyses skip.
GATEWAY_CAPTURE_URL=
# Shared secret between the gateway and the worker (e.g. `openssl rand -hex 24`).
CAPTURE_TOKEN=
# How long the worker waits for the first decoded frame; the whole photo may take
# GATEWAY_PHOTO_TIMEOUT_SECONDS (stream token, the mower starting to publish, the frame).
CAPTURE_TIMEOUT_SECONDS=20
GATEWAY_PHOTO_TIMEOUT_SECONDS=30
# Captures at the same time (each a browser page with a video decoder).
CAPTURE_MAX_CONCURRENCY=2
# Empty: Playwright's Chromium headless shell. "chrome" needs Google Chrome in the image (only
# when the camera stream needs H.264 and Chromium cannot decode it).
CAPTURE_BROWSER_CHANNEL=
