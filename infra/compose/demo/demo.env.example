# The public demo's settings (ADR 0068, docs/ops/demo.md), read after ../.env.example:
#
#   cp demo/demo.env.example demo/demo.env    # git-ignored; then fill in the secrets below
#   demo/reset.sh                             # (re)creates the demo stack
#
# The demo is its own Compose project with its own database, volumes, network and secrets. Never
# reuse a value of an installation with real mowers here, and never point this file at one.

# --- Project and network (never "mowdeck", the regular stack) ---
COMPOSE_PROJECT_NAME=mowdeck-demo
MOWDECK_NETWORK=mowdeck-demo
MOWDECK_TRAEFIK_PROJECT=mowdeck-demo
MOWDECK_ENVIRONMENT=prod

# --- Host ports: the demo's web app and API; the databases stay on 127.0.0.1 ---
# Put your own TLS proxy in front (GATEWAY_TRUSTED_PROXIES), or bind to 127.0.0.1 for a tunnel.
GATEWAY_HTTP_PORT=127.0.0.1:8580
GATEWAY_HTTPS_PORT=127.0.0.1:8581
GATEWAY_TRUSTED_PROXIES=
POSTGRES_PORT=8582
NATS_CLIENT_PORT=8583
NATS_MONITOR_PORT=8584
OPENFGA_HTTP_PORT=8585
OPENFGA_GRPC_PORT=8586
IDENTITY_REFRESH_COOKIE_SECURE=true
# The address visitors open, for the WebSocket origin check (e.g. https://demo.example.org).
REALTIME_ALLOWED_ORIGINS=http://localhost:8580

# --- Secrets of this demo only (generate each one; reset.sh refuses the placeholders) ---
#   openssl rand -hex 32                    (passwords, the seed token)
#   openssl rand -base64 32                 (IDENTITY_KEY_ENCRYPTION_KEY)
POSTGRES_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me
OPENFGA_AUTHN_PRESHARED_KEYS=change-me
IDENTITY_KEY_ENCRYPTION_KEY=change-me
# Shared secret of the seed job (demo/seed.py): with it a request passes the demo policy. Traefik
# removes its header from every outside request; it is only used inside the Compose network.
DEMO_SEED_TOKEN=change-me
# No manufacturer accounts in a demo: Fleet runs without a credential key.
FLEET_CREDENTIAL_ENCRYPTION_KEY=

# --- What the demo shows ---
# Hours between two resets (the banner tells visitors; the timer of docs/ops/demo.md runs
# reset.sh at this interval).
DEMO_RESET_HOURS=6
# Days of seeded history per mower (1 to 31).
DEMO_HISTORY_DAYS=7
# Simulated seconds per real second of the live mowers.
DEMO_SIM_TIME_SCALE=3
# Requests per minute and burst per client address at the gateway.
DEMO_RATE_PER_MINUTE=300
DEMO_RATE_BURST=150
# Message language of the in-app notifications (de, en).
NOTIFICATIONS_DEFAULT_LANGUAGE=en
NOTIFICATIONS_MOWING_MIN_SECONDS=30

# --- Kept off in a demo (no third party learns anything about a visitor) ---
WEB_MAP_TILES=
AERIAL_WMS_URL=
AERIAL_XYZ_URL=
BASEMAP_URL=
WEB_CAMERA_ENABLED=false
WEB_AGORA_SDK=exclude
WEB_LEGAL_ENABLED=false
ENTITLEMENTS_BILLING_ENABLED=false
COMPOSE_PROFILES=
